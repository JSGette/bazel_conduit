# OTLP protos vendored unmodified from
# https://github.com/open-telemetry/opentelemetry-proto (v1.11.1, Apache-2.0).

load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")

proto_library(
    name = "otlp_proto",
    srcs = [
        "proto/collector/logs/v1/logs_service.proto",
        "proto/collector/trace/v1/trace_service.proto",
        "proto/common/v1/common.proto",
        "proto/logs/v1/logs.proto",
        "proto/resource/v1/resource.proto",
        "proto/trace/v1/trace.proto",
    ],
    strip_import_prefix = "/proto",
)

rust_prost_library(
    name = "otlp_rust_proto",
    proto = ":otlp_proto",
    visibility = ["//visibility:public"],
)
